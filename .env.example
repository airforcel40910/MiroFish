# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# =====================================================================
# Anthropic Claude（OpenAI 兼容端点）示例 / Anthropic block
# To use it: comment out the block above, uncomment the lines below.
# 使用方法：注释掉上面的配置，取消注释下面各行。
# =====================================================================
# Your Anthropic API key (https://console.anthropic.com/settings/keys)
# LLM_API_KEY=sk-ant-your_key_here
# Anthropic's OpenAI-compatible endpoint (keep the trailing slash)
# LLM_BASE_URL=https://api.anthropic.com/v1/
# Main model: ontology, personas, simulation config, reports, ReportAgent chat
# LLM_MODEL_NAME=claude-sonnet-5-5
# Boost key for per-agent simulation actions; blank = reuse LLM_API_KEY
# LLM_BOOST_API_KEY=
# Boost base URL; blank = reuse LLM_BASE_URL
# LLM_BOOST_BASE_URL=
# Boost model for high-volume agent actions; blank = use LLM_MODEL_NAME
# LLM_BOOST_MODEL_NAME=claude-haiku-5-5
# Zep Cloud memory graph key (https://app.getzep.com/)
# ZEP_API_KEY=your_zep_api_key_here
# Max concurrent LLM requests per process (default 4); lower it if you hit 429s
# LLM_MAX_CONCURRENCY=4
